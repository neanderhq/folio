{
  "name": "folio",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build && node .neander/prepare-standalone.mjs",
    "start": "node .next/standalone/server.js",
    "check": "tsc --noEmit",
    "seed": "node --env-file-if-exists=.env.local --import tsx scripts/seed.ts",
    "template:seed": "node scripts/initialize-template.mjs",
    "test": "python3 scripts/test_deployment_contract.py",
    "test:template": "tsx scripts/verify-template.ts",
    "test:policy": "python3 scripts/check_repository.py",
    "verify": "pnpm run check && pnpm run test && pnpm run test:policy && pnpm run build",
    "test:production": "tsx scripts/verify-template.ts",
    "test:ui": "tsx scripts/check-record-editor-ui.ts"
  },
  "dependencies": {
    "@next/env": "16.4.6",
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "drizzle-kit": "0.31.10",
    "playwright": "1.61.1",
    "tsx": "4.20.6",
    "typescript": "7.0.2"
  },
  "license": "MIT"
}
